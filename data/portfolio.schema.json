{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio content",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "contact", "resume", "projects", "skills", "art", "music"],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles", "tagline", "about"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tagline": { "type": "string", "minLength": 1 },
        "about": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disciplines": { "type": "array", "items": { "$ref": "#/definitions/discipline" } },
        "backgroundVideo": { "$ref": "#/definitions/sceneVideo" },
        "backgroundVideoRotate": { "$ref": "#/definitions/sceneVideoRotate" }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "art": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "location", "availability", "githubUrl", "linkedinUrl"],
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "location": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "minLength": 1 },
        "githubUrl": { "$ref": "#/definitions/optionalUrl" },
        "linkedinUrl": { "$ref": "#/definitions/optionalUrl" }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "updated", "role", "summary", "technicalSkills", "strengths", "experience", "education"],
      "properties": {
        "url": { "$ref": "#/definitions/localPath" },
        "updated": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "technicalSkills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "strengths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "organization", "location", "timeframe", "highlights"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "organization": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 },
              "timeframe": { "type": "string", "minLength": 1 },
              "highlights": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "education": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/definitions/project" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/skillGroup" }
    },
    "art": {
      "type": "array",
      "items": { "$ref": "#/definitions/artwork" }
    },
    "music": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "src"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "src": { "$ref": "#/definitions/localPath" }
        }
      }
    }
  },
  "definitions": {
    "optionalUrl": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "pattern": "^https?://" }
      ]
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(img|music|documents|video)/"
    },
    "sceneVideo": {
      "description": "Optional moving backdrop, faded behind the scene.",
      "oneOf": [{ "const": "" }, { "type": "string", "pattern": "^video/" }]
    },
    "sceneVideoRotate": {
      "description": "Quarter turn for footage stored in the wrong orientation.",
      "enum": [0, 90, 180, 270]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "theme": {
      "description": "Atmosphere preset the showcase renders this item with.",
      "enum": ["apps", "ai", "games", "art"]
    },
    "accent": {
      "description": "Optional per-item accent override as a hex colour.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "discipline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "title", "blurb", "href"],
      "properties": {
        "theme": { "$ref": "#/definitions/theme" },
        "title": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^#" }
      }
    },
    "devlogEntry": {
      "description": "One dated development update. Only date and title are required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "body": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "videoUrl": { "$ref": "#/definitions/optionalUrl" },
        "embed": { "$ref": "#/definitions/optionalUrl" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": { "$ref": "#/definitions/localPath" },
              "alt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "detail": {
      "description": "Expanded project view content shown in the details drawer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "roadmap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "implemented": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "inProgress": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "planned": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "galleryImage": {
      "oneOf": [
        { "$ref": "#/definitions/localPath" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": { "$ref": "#/definitions/localPath" },
            "alt": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "categories", "subtitle", "role", "timeframe", "engine", "image", "thumbnail", "characterImage", "characterAlt", "imageAlt", "summary", "details", "highlights", "tags", "featured", "sortOrder", "galleryImages", "videoUrl", "links"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "categories": { "$ref": "#/definitions/categories" },
        "theme": { "$ref": "#/definitions/theme" },
        "accent": { "$ref": "#/definitions/accent" },
        "status": {
          "description": "One label, or several: e.g. [\"In Development\", \"Migrated to C++\"].",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "platform": { "type": "string", "minLength": 1 },
        "devlog": { "type": "array", "items": { "$ref": "#/definitions/devlogEntry" } },
        "heroImage": { "oneOf": [{ "const": "" }, { "$ref": "#/definitions/localPath" }] },
        "heroAlt": { "type": "string" },
        "heroStyle": { "enum": ["cutout", "frame"] },
        "backgroundImage": { "oneOf": [{ "const": "" }, { "$ref": "#/definitions/localPath" }] },
        "backgroundVideo": { "$ref": "#/definitions/sceneVideo" },
        "backgroundVideoRotate": { "$ref": "#/definitions/sceneVideoRotate" },
        "detail": { "$ref": "#/definitions/detail" },
        "subtitle": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "embed": { "$ref": "#/definitions/optionalUrl" },
        "image": { "$ref": "#/definitions/localPath" },
        "thumbnail": { "$ref": "#/definitions/localPath" },
        "characterImage": { "oneOf": [{ "const": "" }, { "$ref": "#/definitions/localPath" }] },
        "characterAlt": { "type": "string" },
        "imageAlt": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "string", "minLength": 1 },
        "highlights": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer", "minimum": 1 },
        "galleryImages": { "type": "array", "items": { "$ref": "#/definitions/galleryImage" } },
        "videoUrl": { "$ref": "#/definitions/optionalUrl" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https?://" }
            }
          }
        }
      }
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "items"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "percent", "sortOrder"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
              "sortOrder": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "categories", "year", "src", "thumbnail", "alt", "description", "relatedProject", "sortOrder"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "categories": { "$ref": "#/definitions/categories" },
        "accent": { "$ref": "#/definitions/accent" },
        "year": { "type": "string", "minLength": 1 },
        "src": { "$ref": "#/definitions/localPath" },
        "thumbnail": { "$ref": "#/definitions/localPath" },
        "alt": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "relatedProject": { "type": "string" },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
